#!/usr/bin/env python3
"""Watch a running loom-selfimprove loop live: progress, commands, file diffs, decisions.

    scripts/loom-watch                 # newest run
    scripts/loom-watch <run-dir>       # a specific run
    scripts/loom-watch --no-output     # hide command output, keep commands and diffs

Reads only the files the loop writes (run.log, agent-N.jsonl, review-N.jsonl), so it can
be started, stopped and restarted at any time without affecting the loop.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RUNS = ROOT / ".custom-tui" / "selfimprove"

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if COLOR else text


DIM, BOLD, RED, GREEN, YELLOW, BLUE, CYAN = "2", "1", "31", "32", "33", "34", "36"


def short(text: str, limit: int) -> str:
    text = text.strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


def unwrap(command: str) -> str:
    m = re.match(r"^/bin/(?:ba|z)?sh -lc ['\"](.*)['\"]$", command, re.S)
    return m.group(1) if m else command


class Follower:
    """Yield new complete lines of a file as it grows."""

    def __init__(self, path: Path, from_start: bool = True):
        self.path = path
        self.offset = 0 if from_start or not path.exists() else path.stat().st_size
        self.buffer = ""

    def lines(self):
        if not self.path.exists():
            return []
        size = self.path.stat().st_size
        if size < self.offset:
            self.offset = 0
        if size == self.offset:
            return []
        with open(self.path, "r", errors="replace") as f:
            f.seek(self.offset)
            chunk = f.read()
            self.offset = f.tell()
        self.buffer += chunk
        *complete, self.buffer = self.buffer.split("\n")
        return complete


def show_diff(diff: str, max_lines: int):
    lines = diff.splitlines()
    for line in lines[:max_lines]:
        if line.startswith("+") and not line.startswith("+++"):
            print(c(GREEN, "      " + line))
        elif line.startswith("-") and not line.startswith("---"):
            print(c(RED, "      " + line))
        elif line.startswith("@@"):
            print(c(CYAN, "      " + line))
        else:
            print(c(DIM, "      " + line))
    if len(lines) > max_lines:
        print(c(DIM, f"      … {len(lines) - max_lines} more diff lines"))


def file_diff(run: Path, path: str) -> str:
    """Diff of one file in the run's work copy against its last commit."""
    crate = run / "work" / "loom-tui"
    rel = os.path.relpath(path, crate) if os.path.isabs(path) else path
    import subprocess
    out = subprocess.run(["git", "-C", str(crate), "diff", "--no-color", "-U2", "--", rel], capture_output=True, text=True).stdout
    if not out:  # new, untracked file
        out = subprocess.run(["git", "-C", str(crate), "diff", "--no-color", "--no-index", "/dev/null", rel],
                             capture_output=True, text=True, cwd=crate).stdout
    return "\n".join(l for l in out.splitlines() if not l.startswith(("diff --git", "index ", "--- ", "+++ ")))


def codex_event(ev: dict, args, run: Path):
    """Codex exec --json events."""
    kind = ev.get("type")
    item = ev.get("item") or {}
    if kind == "item.started" and item.get("type") == "command_execution":
        print(c(YELLOW, "  $ ") + short(unwrap(item.get("command", "")), 200), flush=True)
    elif kind == "item.completed":
        t = item.get("type")
        if t == "command_execution":
            code = item.get("exit_code")
            out = (item.get("aggregated_output") or "").strip().splitlines()
            mark = c(GREEN, "✓") if code == 0 else c(RED, f"✗ exit {code}")
            tail = "" if args.no_output or not out else c(DIM, " · " + short(out[-1], 140))
            print(f"    {mark}{tail}", flush=True)
        elif t == "file_change":
            for change in item.get("changes", []):
                path = change.get("path", "")
                shown = os.path.relpath(path, run / "work" / "loom-tui") if os.path.isabs(path) else path
                print(c(BOLD + ";" + BLUE, f"  ✎ {change.get('kind', 'edit')} {shown}"))
                show_diff(change.get("diff") or file_diff(run, path), args.diff_lines)
        elif t == "agent_message":
            print(c(BOLD, "  ● ") + short(item.get("text", ""), 600).replace("\n", "\n    "), flush=True)
        elif t == "error":
            print(c(RED, "  ! " + short(item.get("message", ""), 300)))
    elif kind == "turn.completed":
        usage = ev.get("usage", {})
        print(c(DIM, f"  · turn done · input {usage.get('input_tokens')} cached {usage.get('cached_input_tokens')} output {usage.get('output_tokens')}"))
    elif kind in ("error", "turn.failed"):
        msg = ev.get("message") or (ev.get("error") or {}).get("message", "")
        print(c(RED, "  ! " + short(msg, 300)))


def loom_event(ev: dict, args):
    """Loom worker --trace events."""
    if "outcome" in ev:
        o = ev["outcome"]
        print(c(BOLD, f"  ■ {o.get('stop_reason')} · {o.get('steps')} steps · input {o.get('input_tokens')} · edits {', '.join(o.get('edits') or []) or 'none'}"))
    elif "tool" in ev:
        mark = c(RED, "✗") if ev.get("error") else c(GREEN, "✓")
        result = ev.get("result", "")
        if ev["tool"] in ("edit", "write") and not ev.get("error"):
            print(f"    {mark} {ev['tool']}")
            show_diff(result, args.diff_lines)
        else:
            first = "" if args.no_output else c(DIM, " · " + short(result.splitlines()[0] if result else "", 140))
            print(f"    {mark} {ev['tool']}{first}")
    elif "calls" in ev:
        if ev.get("text"):
            print(c(BOLD, "  ● ") + short(ev["text"], 400).replace("\n", "\n    "))
        for call in ev["calls"]:
            print(c(YELLOW, f"  → {call['tool']} ") + c(DIM, short(json.dumps(call.get("args", {}), ensure_ascii=False), 160)), flush=True)
    elif "error" in ev:
        print(c(RED, "  ! " + short(str(ev["error"]), 300)))


def watch(run: Path, args):
    print(c(BOLD, f"watching {run}") + c(DIM, "  (Ctrl+C to stop watching; the loop keeps running)"), flush=True)
    log = Follower(run / "run.log")
    agents: dict[Path, Follower] = {}
    while True:
        for line in log.lines():
            if re.match(r"^\[\d+\] \d\d:\d\d ", line) or line.startswith("[") and "problems:" in line:
                print("\n" + c(BOLD + ";" + CYAN, "━━ " + line))
            elif "KEPT" in line:
                print(c(BOLD + ";" + GREEN, "━━ " + line))
            elif "REVERTED" in line or "FAIL" in line:
                print(c(BOLD + ";" + RED, "━━ " + line))
            elif re.match(r"^\[\d+\] (fix|improve|implementing):", line):
                print(c(BOLD + ";" + YELLOW, "━━ " + line))
            elif line.strip():
                print(c(DIM, line))
        for path in sorted(run.glob("*.jsonl")):
            if path.name == "log.jsonl":
                continue
            if path not in agents:
                agents[path] = Follower(path)
                print(c(BOLD + ";" + BLUE, f"\n── {path.stem} ──"))
            for line in agents[path].lines():
                try:
                    ev = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if "type" in ev:
                    codex_event(ev, args, run)
                else:
                    loom_event(ev, args)
        sys.stdout.flush()
        time.sleep(0.5)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("run", nargs="?", help="run directory (default: newest)")
    ap.add_argument("--no-output", action="store_true", help="hide the last output line of commands")
    ap.add_argument("--diff-lines", type=int, default=40)
    args = ap.parse_args()
    if args.run:
        run = Path(args.run)
    else:
        runs = sorted((p for p in RUNS.glob("2*") if p.is_dir()), key=lambda p: p.name)
        if not runs:
            sys.exit(f"no runs in {RUNS}")
        run = runs[-1]
    try:
        watch(run, args)
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
